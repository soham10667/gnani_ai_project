# ==========================================
# EchoTrust Enterprise Environment Configuration
# ==========================================

# Server Host & Port
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# JWT Authentication Secret (Set a strong random value in production)
JWT_SECRET=replace_with_a_strong_random_jwt_secret

# Supabase PostgreSQL Configuration
# (If left empty, the application runs on resilient local SQLite with the exact same schema)
SUPABASE_URL=
SUPABASE_KEY=

# Official Gnani AI Speech-to-Text & Text-to-Speech API Configuration
GNANI_API_KEY=your_gnani_api_key_here
GNANI_STT_API_URL=https://api.vachana.ai/stt/v3
GNANI_STT_ENDPOINT=https://api.vachana.ai/stt/v3
GNANI_STT_MODEL=prisma-v3.0
GNANI_MODEL=prisma-v3.0
GNANI_LANG_CODE=indic-auto
GNANI_LANG_CANDIDATES=hi-IN,en-IN
GNANI_STT_FORMAT=transcribe
GNANI_CUSTOMER_ID=ApexBank-BFSI

# Official Gnani AI Text-to-Speech (Timbre v3.0 - Devansh Conversational Male Voice)
GNANI_TTS_API_URL=https://api.vachana.ai
GNANI_TTS_MODEL=timbre-v3.0
GNANI_TTS_VOICE=Devansh
GNANI_TTS_LANGUAGE=hi-IN

# External LLM API Configuration (Set at least one real API key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Enterprise Confidence Thresholds (0 - 100%)
THRESHOLD_HIGH=90.0
THRESHOLD_MEDIUM=70.0
THRESHOLD_AUTO_PASS=90.0
THRESHOLD_MANDATORY_READBACK=75.0
THRESHOLD_AUTO_REJECT=60.0

# Phonetic Standard ("nato" | "indian" | "digit_grouped")
PHONETIC_STANDARD=nato
