# ==========================================
# VeriVoice Enterprise Environment Configuration
# ==========================================

# Server Host & Port
HOST=0.0.0.0
PORT=8000

# Supabase PostgreSQL Configuration
# (If left empty, the application runs on resilient local SQLite with the exact same schema)
SUPABASE_URL=
SUPABASE_KEY=

# Gnani AI Speech-to-Text API Credentials
# (If left empty, dedicated mock simulation mode activates with honest indicators)
GNANI_API_KEY=
GNANI_TOKEN=
GNANI_ACCESS_TOKEN=
GNANI_CUSTOMER_ID=ApexBank-BFSI
GNANI_LANG_CODE=en-IN
GNANI_MODEL=prisma-v3.0
GNANI_STT_ENDPOINT=https://api.vachana.ai/stt/v3

# Enterprise Confidence Thresholds (0 - 100%)
THRESHOLD_HIGH=90.0
THRESHOLD_MEDIUM=70.0
THRESHOLD_AUTO_PASS=90.0
THRESHOLD_MANDATORY_READBACK=75.0
THRESHOLD_AUTO_REJECT=60.0

# Phonetic Standard ("nato" | "indian" | "digit_grouped")
PHONETIC_STANDARD=nato

